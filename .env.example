# Local development only. In production the settings live on the server in /opt/ic-booking/settings.env
PORT=3000
NODE_ENV=development

# Frontends allowed by CORS, and used to build links inside reminder emails
ADMIN_FRONTEND_URL=http://localhost:3001
CANDIDATE_FRONTEND_URL=http://localhost:3002

# candidate-form-details-service (in Docker: http://form-service:3000/api/v1)
CANDIDATE_FORM_DETAILS_SERVICE_BASE_URL=http://localhost:3000/api/v1

# Shared secret for the key-protected /api/v1/internal-job/* routes
INTERNAL_API_KEY_HEADER=x-internal-api-key
SCHEDULER_INTERNAL_API_KEY=

# Distributed slot-lock TTL (ms)
LOCK_TTL=50000

# Bookable dates are kept generated this many days ahead (rolling window)
SLOT_WINDOW_DAYS=90

REDIS_HOST=localhost
REDIS_PORT=6379
# Production Redis (ElastiCache) needs both:
# REDIS_TLS=true
# REDIS_PASSWORD=

DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=ic_lead_booking
# Production RDS: encrypt + verify against the AWS CA bundle baked into the image
# DB_SSL=true

# Local sequelize-cli only (production migrations use DB_*)
DEV_DB_HOST=localhost
DEV_DB_USER=
DEV_DB_PASSWORD=
DEV_DB_NAME=ic_lead_booking_booking

# Reverse proxies in front of the app (Caddy = 1). Needed for correct per-IP rate limiting.
TRUST_PROXY=1
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600
RATE_LIMIT_WRITE_MAX=60

# Notification queue retry policy (defaults shown)
# QUEUE_JOB_ATTEMPTS=5
# QUEUE_RETRY_BACKOFF_MS=30000
# QUEUE_FAILED_RETENTION_DAYS=1
# QUEUE_FAILED_RETENTION_COUNT=5000
