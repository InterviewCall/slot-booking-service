{
  "name": "express-typescript-starter",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "ts-node src/server.ts",
    "dev": "nodemon --watch src --ext ts --exec 'tsx src/server.ts'",
    "migration:generate": "sequelize-cli migration:generate --name",
    "seed:generate": "sequelize-cli seed:generate --name",
    "migrate": "sequelize-cli db:migrate",
    "seed:all": "sequelize-cli db:seed:all",
    "seed": "sequelize-cli db:seed --seed",
    "seed:undo": "sequelize-cli db:seed:undo",
    "seed:undo:all": "sequelize-cli db:seed:undo:all",
    "rollback": "sequelize-cli db:migrate:undo"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "axios": "^1.16.1",
    "bullmq": "^5.78.0",
    "cors": "^2.8.6",
    "dayjs": "^1.11.20",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "http-status-codes": "^2.3.0",
    "ioredis": "^5.10.1",
    "mysql2": "^3.22.3",
    "redlock-universal": "^0.8.5",
    "sequelize": "^6.37.8",
    "uuid": "^14.0.0",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.25.46"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.2",
    "@types/node": "^22.15.29",
    "@typescript-eslint/eslint-plugin": "^8.33.0",
    "@typescript-eslint/parser": "^8.33.0",
    "eslint": "^9.28.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "nodemon": "^3.1.10",
    "sequelize-cli": "^6.6.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "sequelize": {
      "uuid": "^14.0.0"
    }
  },
  "allowScripts": {
    "esbuild@0.28.0": true,
    "fsevents@2.3.3": true,
    "msgpackr-extract@3.0.4": true
  }
}
